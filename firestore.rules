rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Hardened Global Helpers
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isVerified() && request.auth.uid == userId;
    }

    function isBootstrappedSuperAdmin() {
      return isVerified() && request.auth.token.email == 'codenexgen1@gmail.com';
    }

    function hasAdminDoc() {
      return isVerified() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function adminDoc() {
      return get(/databases/$(database)/documents/admins/$(request.auth.uid)).data;
    }

    function isStaff() {
      return isBootstrappedSuperAdmin() || (hasAdminDoc() && adminDoc().active == true);
    }

    function isSuperAdmin() {
      return isBootstrappedSuperAdmin() || (hasAdminDoc() && adminDoc().active == true && adminDoc().role == 'Super Admin');
    }

    function hasPermission(perm) {
      return isBootstrappedSuperAdmin() || (
        hasAdminDoc() &&
        adminDoc().active == true &&
        (adminDoc().role == 'Super Admin' || (adminDoc().permissions is list && perm in adminDoc().permissions))
      );
    }

    // 3. Entity Validation Blueprints
    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'fullName', 'email', 'role', 'emailVerified', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'fullName', 'email', 'phone', 'photoUrl', 'role', 'emailVerified', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128
        && data.fullName is string && data.fullName.size() >= 1 && data.fullName.size() <= 120
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 200
        && (!('phone' in data) || (data.phone is string && data.phone.size() <= 32))
        && (!('photoUrl' in data) || (data.photoUrl is string && data.photoUrl.size() <= 500))
        && data.role in ['Customer', 'Customer Support', 'Marketing Manager', 'Inventory Manager', 'Order Manager', 'Store Manager', 'Admin', 'Super Admin']
        && data.emailVerified is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAddress(data) {
      return data.keys().hasAll(['userId', 'fullName', 'phone', 'city', 'area', 'completeAddress', 'isDefault', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['userId', 'fullName', 'phone', 'city', 'area', 'completeAddress', 'postalCode', 'isDefault', 'createdAt', 'updatedAt'])
        && data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128
        && data.fullName is string && data.fullName.size() >= 1 && data.fullName.size() <= 120
        && data.phone is string && data.phone.size() >= 5 && data.phone.size() <= 32
        && data.city is string && data.city.size() >= 2 && data.city.size() <= 80
        && data.area is string && data.area.size() >= 1 && data.area.size() <= 120
        && data.completeAddress is string && data.completeAddress.size() >= 4 && data.completeAddress.size() <= 300
        && (!('postalCode' in data) || (data.postalCode is string && data.postalCode.size() <= 20))
        && data.isDefault is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidWishlistItem(data) {
      return data.keys().hasAll(['userId', 'productId', 'productName', 'productSlug', 'price', 'createdAt'])
        && data.keys().hasOnly(['userId', 'productId', 'productName', 'productSlug', 'price', 'image', 'createdAt'])
        && data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128
        && data.productId is string && data.productId.size() >= 1 && data.productId.size() <= 128
        && data.productName is string && data.productName.size() >= 1 && data.productName.size() <= 180
        && data.productSlug is string && data.productSlug.size() >= 1 && data.productSlug.size() <= 180
        && data.price is number && data.price >= 0
        && (!('image' in data) || (data.image is string && data.image.size() <= 500))
        && data.createdAt is timestamp;
    }

    function isValidAdminRecord(data) {
      return data.keys().hasAll(['uid', 'email', 'fullName', 'role', 'permissions', 'active', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'fullName', 'role', 'permissions', 'active', 'assignedBy', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 200
        && data.fullName is string && data.fullName.size() >= 1 && data.fullName.size() <= 120
        && data.role in ['Super Admin', 'Admin', 'Store Manager', 'Order Manager', 'Inventory Manager', 'Marketing Manager', 'Customer Support']
        && data.permissions is list && data.permissions.size() <= 30
        && (data.permissions.size() == 0 || data.permissions[0] is string)
        && data.active is bool
        && (!('assignedBy' in data) || (data.assignedBy is string && data.assignedBy.size() <= 128))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidCategory(data) {
      return data.keys().hasAll(['name', 'slug', 'active', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['name', 'slug', 'description', 'image', 'sortOrder', 'active', 'isDemo', 'createdAt', 'updatedAt'])
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 100
        && data.slug is string && data.slug.size() >= 1 && data.slug.size() <= 120
        && (!('description' in data) || (data.description is string && data.description.size() <= 500))
        && (!('image' in data) || (data.image is string && data.image.size() <= 500))
        && (!('sortOrder' in data) || data.sortOrder is number)
        && data.active is bool
        && (!('isDemo' in data) || data.isDemo is bool)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidCollection(data) {
      return data.keys().hasAll(['name', 'slug', 'active', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['name', 'slug', 'season', 'description', 'image', 'featured', 'active', 'isDemo', 'createdAt', 'updatedAt'])
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 120
        && data.slug is string && data.slug.size() >= 1 && data.slug.size() <= 120
        && (!('season' in data) || (data.season is string && data.season.size() <= 80))
        && (!('description' in data) || (data.description is string && data.description.size() <= 500))
        && (!('image' in data) || (data.image is string && data.image.size() <= 500))
        && (!('featured' in data) || data.featured is bool)
        && data.active is bool
        && (!('isDemo' in data) || data.isDemo is bool)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidProduct(data) {
      return data.keys().hasAll(['name', 'slug', 'sku', 'categoryName', 'price', 'stockQuantity', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'name', 'slug', 'sku', 'categoryId', 'categoryName', 'collectionId', 'collectionName',
          'brand', 'shortDescription', 'description', 'price', 'salePrice', 'costPrice',
          'images', 'videoUrl', 'fabricDetails', 'productType', 'colors', 'sizes', 'variants',
          'stockQuantity', 'trackInventory', 'featured', 'newArrival', 'bestSeller', 'onSale',
          'tags', 'seoTitle', 'seoDescription', 'metaKeywords', 'weightGrams', 'shippingInfo',
          'status', 'viewCount', 'wishlistCount', 'salesCount', 'isDemo', 'createdAt', 'updatedAt'
        ])
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 180
        && data.slug is string && data.slug.size() >= 1 && data.slug.size() <= 180
        && data.sku is string && data.sku.size() >= 1 && data.sku.size() <= 64
        && (!('categoryId' in data) || (data.categoryId is string && data.categoryId.size() <= 128))
        && data.categoryName is string && data.categoryName.size() >= 1 && data.categoryName.size() <= 100
        && (!('collectionId' in data) || (data.collectionId is string && data.collectionId.size() <= 128))
        && (!('collectionName' in data) || (data.collectionName is string && data.collectionName.size() <= 120))
        && (!('brand' in data) || (data.brand is string && data.brand.size() <= 80))
        && (!('shortDescription' in data) || (data.shortDescription is string && data.shortDescription.size() <= 300))
        && (!('description' in data) || (data.description is string && data.description.size() <= 4000))
        && data.price is number && data.price >= 0
        && (!('salePrice' in data) || (data.salePrice is number && data.salePrice >= 0))
        && (!('costPrice' in data) || (data.costPrice is number && data.costPrice >= 0))
        && (!('images' in data) || (data.images is list && data.images.size() <= 12 && (data.images.size() == 0 || data.images[0] is string)))
        && (!('videoUrl' in data) || (data.videoUrl is string && data.videoUrl.size() <= 500))
        && (!('fabricDetails' in data) || (data.fabricDetails is string && data.fabricDetails.size() <= 400))
        && (!('productType' in data) || (data.productType is string && data.productType.size() <= 80))
        && (!('colors' in data) || (data.colors is list && data.colors.size() <= 15))
        && (!('sizes' in data) || (data.sizes is list && data.sizes.size() <= 15 && (data.sizes.size() == 0 || data.sizes[0] is string)))
        && (!('variants' in data) || (data.variants is list && data.variants.size() <= 60))
        && data.stockQuantity is number && data.stockQuantity >= 0
        && (!('trackInventory' in data) || data.trackInventory is bool)
        && (!('featured' in data) || data.featured is bool)
        && (!('newArrival' in data) || data.newArrival is bool)
        && (!('bestSeller' in data) || data.bestSeller is bool)
        && (!('onSale' in data) || data.onSale is bool)
        && (!('tags' in data) || (data.tags is list && data.tags.size() <= 20 && (data.tags.size() == 0 || data.tags[0] is string)))
        && (!('seoTitle' in data) || (data.seoTitle is string && data.seoTitle.size() <= 160))
        && (!('seoDescription' in data) || (data.seoDescription is string && data.seoDescription.size() <= 300))
        && (!('metaKeywords' in data) || (data.metaKeywords is string && data.metaKeywords.size() <= 300))
        && (!('weightGrams' in data) || (data.weightGrams is number && data.weightGrams >= 0))
        && (!('shippingInfo' in data) || (data.shippingInfo is string && data.shippingInfo.size() <= 300))
        && data.status in ['Draft', 'Active', 'Out of Stock', 'Archived']
        && (!('viewCount' in data) || data.viewCount is number)
        && (!('wishlistCount' in data) || data.wishlistCount is number)
        && (!('salesCount' in data) || data.salesCount is number)
        && (!('isDemo' in data) || data.isDemo is bool)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidInventoryMovement(data) {
      return data.keys().hasAll(['productId', 'type', 'quantityDelta', 'previousStock', 'newStock', 'performedBy', 'createdAt'])
        && data.keys().hasOnly(['productId', 'productName', 'variantSku', 'type', 'quantityDelta', 'previousStock', 'newStock', 'reason', 'supplier', 'performedBy', 'createdAt'])
        && data.productId is string && data.productId.size() >= 1 && data.productId.size() <= 128
        && (!('productName' in data) || (data.productName is string && data.productName.size() <= 180))
        && (!('variantSku' in data) || (data.variantSku is string && data.variantSku.size() <= 80))
        && data.type in ['Purchase', 'Sale', 'Return', 'Damage', 'Adjustment', 'Reservation', 'Release']
        && data.quantityDelta is number
        && data.previousStock is number && data.previousStock >= 0
        && data.newStock is number && data.newStock >= 0
        && (!('reason' in data) || (data.reason is string && data.reason.size() <= 300))
        && (!('supplier' in data) || (data.supplier is string && data.supplier.size() <= 120))
        && data.performedBy is string && data.performedBy.size() >= 1 && data.performedBy.size() <= 128
        && data.createdAt is timestamp;
    }

    function isValidOrder(data) {
      return data.keys().hasAll([
          'orderNumber', 'userId', 'customerName', 'customerEmail', 'customerPhone',
          'city', 'completeAddress', 'paymentMethod', 'paymentStatus', 'orderStatus',
          'items', 'subtotal', 'totalAmount', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'orderNumber', 'userId', 'customerName', 'customerEmail', 'customerPhone',
          'city', 'area', 'completeAddress', 'postalCode', 'shippingMethod',
          'paymentMethod', 'paymentStatus', 'orderStatus', 'items', 'subtotal',
          'discountAmount', 'couponCode', 'shippingCost', 'taxAmount', 'totalAmount',
          'trackingNumber', 'courierName', 'orderNotes', 'statusHistory', 'isDemo',
          'createdAt', 'updatedAt'
        ])
        && data.orderNumber is string && data.orderNumber.size() >= 3 && data.orderNumber.size() <= 40
        && data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128
        && data.customerName is string && data.customerName.size() >= 1 && data.customerName.size() <= 120
        && data.customerEmail is string && data.customerEmail.size() >= 3 && data.customerEmail.size() <= 200
        && data.customerPhone is string && data.customerPhone.size() >= 5 && data.customerPhone.size() <= 32
        && data.city is string && data.city.size() >= 2 && data.city.size() <= 80
        && (!('area' in data) || (data.area is string && data.area.size() <= 120))
        && data.completeAddress is string && data.completeAddress.size() >= 4 && data.completeAddress.size() <= 300
        && (!('postalCode' in data) || (data.postalCode is string && data.postalCode.size() <= 20))
        && (!('shippingMethod' in data) || (data.shippingMethod is string && data.shippingMethod.size() <= 80))
        && data.paymentMethod in ['Cash on Delivery', 'Bank Transfer', 'Easypaisa', 'JazzCash', 'Online Card']
        && data.paymentStatus in ['Pending', 'Paid', 'Failed', 'Refunded']
        && data.orderStatus in ['Order Placed', 'Confirmed', 'Processing', 'Packed', 'Dispatched', 'Out for Delivery', 'Delivered', 'Cancelled', 'Returned', 'Refunded']
        && data.items is list && data.items.size() >= 1 && data.items.size() <= 50
        && data.subtotal is number && data.subtotal >= 0
        && (!('discountAmount' in data) || (data.discountAmount is number && data.discountAmount >= 0))
        && (!('couponCode' in data) || (data.couponCode is string && data.couponCode.size() <= 40))
        && (!('shippingCost' in data) || (data.shippingCost is number && data.shippingCost >= 0))
        && (!('taxAmount' in data) || (data.taxAmount is number && data.taxAmount >= 0))
        && data.totalAmount is number && data.totalAmount >= 0
        && (!('trackingNumber' in data) || (data.trackingNumber is string && data.trackingNumber.size() <= 80))
        && (!('courierName' in data) || (data.courierName is string && data.courierName.size() <= 80))
        && (!('orderNotes' in data) || (data.orderNotes is string && data.orderNotes.size() <= 500))
        && (!('statusHistory' in data) || (data.statusHistory is list && data.statusHistory.size() <= 20))
        && (!('isDemo' in data) || data.isDemo is bool)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidOrderTracking(data) {
      return data.keys().hasAll(['orderNumber', 'orderStatus', 'destinationCity', 'updatedAt'])
        && data.keys().hasOnly(['orderNumber', 'orderStatus', 'courierName', 'trackingNumber', 'destinationCity', 'statusHistory', 'updatedAt'])
        && data.orderNumber is string && data.orderNumber.size() >= 3 && data.orderNumber.size() <= 40
        && data.orderStatus in ['Order Placed', 'Confirmed', 'Processing', 'Packed', 'Dispatched', 'Out for Delivery', 'Delivered', 'Cancelled', 'Returned', 'Refunded']
        && (!('courierName' in data) || (data.courierName is string && data.courierName.size() <= 80))
        && (!('trackingNumber' in data) || (data.trackingNumber is string && data.trackingNumber.size() <= 80))
        && data.destinationCity is string && data.destinationCity.size() >= 2 && data.destinationCity.size() <= 80
        && (!('statusHistory' in data) || (data.statusHistory is list && data.statusHistory.size() <= 20))
        && data.updatedAt is timestamp;
    }

    function isValidReview(data) {
      return data.keys().hasAll(['productId', 'userId', 'authorName', 'rating', 'title', 'comment', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['productId', 'productName', 'userId', 'authorName', 'rating', 'title', 'comment', 'photoUrl', 'verifiedPurchase', 'status', 'featured', 'adminReply', 'isDemo', 'createdAt', 'updatedAt'])
        && data.productId is string && data.productId.size() >= 1 && data.productId.size() <= 128
        && (!('productName' in data) || (data.productName is string && data.productName.size() <= 180))
        && data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128
        && data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 120
        && data.rating is number && data.rating >= 1 && data.rating <= 5
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 160
        && data.comment is string && data.comment.size() >= 1 && data.comment.size() <= 1500
        && (!('photoUrl' in data) || (data.photoUrl is string && data.photoUrl.size() <= 500))
        && (!('verifiedPurchase' in data) || data.verifiedPurchase is bool)
        && data.status in ['Pending', 'Approved', 'Rejected']
        && (!('featured' in data) || data.featured is bool)
        && (!('adminReply' in data) || (data.adminReply is string && data.adminReply.size() <= 800))
        && (!('isDemo' in data) || data.isDemo is bool)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidCoupon(data) {
      return data.keys().hasAll(['code', 'type', 'value', 'active', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['code', 'type', 'value', 'minOrderAmount', 'maxUses', 'usedCount', 'expiresAt', 'active', 'description', 'isDemo', 'createdAt', 'updatedAt'])
        && data.code is string && data.code.size() >= 2 && data.code.size() <= 40
        && data.type in ['Percentage', 'Fixed', 'Free Shipping', 'BOGO']
        && data.value is number && data.value >= 0
        && (!('minOrderAmount' in data) || (data.minOrderAmount is number && data.minOrderAmount >= 0))
        && (!('maxUses' in data) || (data.maxUses is number && data.maxUses >= 0))
        && (!('usedCount' in data) || (data.usedCount is number && data.usedCount >= 0))
        && (!('expiresAt' in data) || (data.expiresAt is string && data.expiresAt.size() <= 64))
        && data.active is bool
        && (!('description' in data) || (data.description is string && data.description.size() <= 240))
        && (!('isDemo' in data) || data.isDemo is bool)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidBanner(data) {
      return data.keys().hasAll(['title', 'subtitle', 'desktopImage', 'active', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['title', 'subtitle', 'ctaPrimaryText', 'ctaPrimaryLink', 'ctaSecondaryText', 'ctaSecondaryLink', 'desktopImage', 'mobileImage', 'active', 'sortOrder', 'isDemo', 'createdAt', 'updatedAt'])
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 160
        && data.subtitle is string && data.subtitle.size() >= 1 && data.subtitle.size() <= 360
        && (!('ctaPrimaryText' in data) || (data.ctaPrimaryText is string && data.ctaPrimaryText.size() <= 60))
        && (!('ctaPrimaryLink' in data) || (data.ctaPrimaryLink is string && data.ctaPrimaryLink.size() <= 200))
        && (!('ctaSecondaryText' in data) || (data.ctaSecondaryText is string && data.ctaSecondaryText.size() <= 60))
        && (!('ctaSecondaryLink' in data) || (data.ctaSecondaryLink is string && data.ctaSecondaryLink.size() <= 200))
        && data.desktopImage is string && data.desktopImage.size() >= 1 && data.desktopImage.size() <= 500
        && (!('mobileImage' in data) || (data.mobileImage is string && data.mobileImage.size() <= 500))
        && data.active is bool
        && (!('sortOrder' in data) || data.sortOrder is number)
        && (!('isDemo' in data) || data.isDemo is bool)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidNewsletter(data) {
      return data.keys().hasAll(['email', 'createdAt'])
        && data.keys().hasOnly(['email', 'source', 'createdAt'])
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 200
        && (!('source' in data) || (data.source is string && data.source.size() <= 60))
        && data.createdAt is timestamp;
    }

    function isValidAnalyticsEvent(data) {
      return data.keys().hasAll(['eventType', 'createdAt'])
        && data.keys().hasOnly(['eventType', 'productId', 'productName', 'categoryName', 'searchQuery', 'city', 'color', 'size', 'source', 'createdAt'])
        && data.eventType in ['page_view', 'product_view', 'category_view', 'search', 'wishlist_add', 'add_to_cart', 'remove_from_cart', 'checkout_start', 'purchase', 'banner_click', 'coupon_use']
        && (!('productId' in data) || (data.productId is string && data.productId.size() <= 128))
        && (!('productName' in data) || (data.productName is string && data.productName.size() <= 180))
        && (!('categoryName' in data) || (data.categoryName is string && data.categoryName.size() <= 100))
        && (!('searchQuery' in data) || (data.searchQuery is string && data.searchQuery.size() <= 120))
        && (!('city' in data) || (data.city is string && data.city.size() <= 80))
        && (!('color' in data) || (data.color is string && data.color.size() <= 60))
        && (!('size' in data) || (data.size is string && data.size.size() <= 40))
        && (!('source' in data) || (data.source is string && data.source.size() <= 80))
        && data.createdAt is timestamp;
    }

    function isValidNotification(data) {
      return data.keys().hasAll(['recipientId', 'audience', 'title', 'message', 'read', 'createdAt'])
        && data.keys().hasOnly(['recipientId', 'audience', 'type', 'title', 'message', 'read', 'link', 'createdAt'])
        && data.recipientId is string && data.recipientId.size() >= 1 && data.recipientId.size() <= 128
        && data.audience in ['admin', 'customer']
        && (!('type' in data) || (data.type is string && data.type.size() <= 60))
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 160
        && data.message is string && data.message.size() >= 1 && data.message.size() <= 500
        && data.read is bool
        && (!('link' in data) || (data.link is string && data.link.size() <= 200))
        && data.createdAt is timestamp;
    }

    function isValidAuditLog(data) {
      return data.keys().hasAll(['actorUid', 'actorEmail', 'action', 'targetType', 'createdAt'])
        && data.keys().hasOnly(['actorUid', 'actorEmail', 'actorRole', 'action', 'targetType', 'targetId', 'details', 'createdAt'])
        && data.actorUid is string && data.actorUid.size() >= 1 && data.actorUid.size() <= 128
        && data.actorEmail is string && data.actorEmail.size() >= 3 && data.actorEmail.size() <= 200
        && (!('actorRole' in data) || (data.actorRole is string && data.actorRole.size() <= 60))
        && data.action is string && data.action.size() >= 1 && data.action.size() <= 120
        && data.targetType is string && data.targetType.size() >= 1 && data.targetType.size() <= 60
        && (!('targetId' in data) || (data.targetId is string && data.targetId.size() <= 128))
        && (!('details' in data) || (data.details is string && data.details.size() <= 500))
        && data.createdAt is timestamp;
    }

    function isValidSettings(data) {
      return data.keys().hasAll(['storeName', 'currency', 'country', 'freeShippingThreshold', 'defaultShippingFee', 'codEnabled', 'guestCheckoutEnabled', 'updatedAt'])
        && data.keys().hasOnly(['storeName', 'currency', 'country', 'warehouseCity', 'freeShippingThreshold', 'defaultShippingFee', 'karachiShippingFee', 'taxRatePercent', 'codEnabled', 'guestCheckoutEnabled', 'whatsappNumber', 'supportEmail', 'updatedAt'])
        && data.storeName is string && data.storeName.size() >= 1 && data.storeName.size() <= 100
        && data.currency is string && data.currency.size() >= 1 && data.currency.size() <= 10
        && data.country is string && data.country.size() >= 1 && data.country.size() <= 60
        && (!('warehouseCity' in data) || (data.warehouseCity is string && data.warehouseCity.size() <= 60))
        && data.freeShippingThreshold is number && data.freeShippingThreshold >= 0
        && data.defaultShippingFee is number && data.defaultShippingFee >= 0
        && (!('karachiShippingFee' in data) || (data.karachiShippingFee is number && data.karachiShippingFee >= 0))
        && (!('taxRatePercent' in data) || (data.taxRatePercent is number && data.taxRatePercent >= 0))
        && data.codEnabled is bool
        && data.guestCheckoutEnabled is bool
        && (!('whatsappNumber' in data) || (data.whatsappNumber is string && data.whatsappNumber.size() <= 32))
        && (!('supportEmail' in data) || (data.supportEmail is string && data.supportEmail.size() <= 160))
        && data.updatedAt is timestamp;
    }

    // 4. Collection Rules
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isStaff());
      allow list: if isBootstrappedSuperAdmin() || (isVerified() && resource.data.uid == request.auth.uid);
      allow create: if isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming())
        && incoming().uid == request.auth.uid
        && incoming().role == 'Customer'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId)
        && isValidUserProfile(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (isSuperAdmin()) ||
          (isOwner(userId)
            && incoming().role == existing().role
            && incoming().diff(existing()).affectedKeys().hasOnly(['fullName', 'phone', 'photoUrl', 'emailVerified', 'updatedAt']))
        );
      allow delete: if isValidId(userId) && isSuperAdmin();

      match /addresses/{addressId} {
        allow get: if isValidId(userId) && isValidId(addressId) && (isOwner(userId) || isStaff());
        allow list: if isVerified() && resource.data.userId == request.auth.uid;
        allow create: if isValidId(userId) && isValidId(addressId)
          && isOwner(userId)
          && isValidAddress(incoming())
          && incoming().userId == request.auth.uid
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isValidId(userId) && isValidId(addressId)
          && isOwner(userId)
          && isValidAddress(incoming())
          && incoming().userId == existing().userId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['fullName', 'phone', 'city', 'area', 'completeAddress', 'postalCode', 'isDefault', 'updatedAt']);
        allow delete: if isValidId(userId) && isValidId(addressId) && isOwner(userId);
      }

      match /wishlists/{productId} {
        allow get: if isValidId(userId) && isValidId(productId) && isOwner(userId);
        allow list: if isVerified() && resource.data.userId == request.auth.uid;
        allow create: if isValidId(userId) && isValidId(productId)
          && isOwner(userId)
          && isValidWishlistItem(incoming())
          && incoming().userId == request.auth.uid
          && incoming().productId == productId
          && incoming().createdAt == request.time;
        allow delete: if isValidId(userId) && isValidId(productId) && isOwner(userId);
      }
    }

    match /admins/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isSuperAdmin());
      allow list: if isBootstrappedSuperAdmin();
      allow create, update: if isValidId(userId)
        && isSuperAdmin()
        && isValidAdminRecord(incoming())
        && incoming().uid == userId
        && incoming().updatedAt == request.time;
      allow delete: if isValidId(userId) && isSuperAdmin();
    }

    match /categories/{categoryId} {
      allow get: if isValidId(categoryId) && (isStaff() || (resource != null && existing().active == true));
      allow list: if existing().active == true || isBootstrappedSuperAdmin();
      allow create: if isValidId(categoryId)
        && hasPermission('products.write')
        && isValidCategory(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(categoryId)
        && hasPermission('products.write')
        && isValidCategory(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'slug', 'description', 'image', 'sortOrder', 'active', 'isDemo', 'updatedAt']);
      allow delete: if isValidId(categoryId) && hasPermission('products.write');
    }

    match /collections/{collectionId} {
      allow get: if isValidId(collectionId) && (isStaff() || (resource != null && existing().active == true));
      allow list: if existing().active == true || isBootstrappedSuperAdmin();
      allow create: if isValidId(collectionId)
        && hasPermission('products.write')
        && isValidCollection(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(collectionId)
        && hasPermission('products.write')
        && isValidCollection(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'slug', 'season', 'description', 'image', 'featured', 'active', 'isDemo', 'updatedAt']);
      allow delete: if isValidId(collectionId) && hasPermission('products.write');
    }

    match /products/{productId} {
      allow get: if isValidId(productId) && (isStaff() || (resource != null && existing().status == 'Active'));
      allow list: if existing().status == 'Active' || isBootstrappedSuperAdmin();
      allow create: if isValidId(productId)
        && hasPermission('products.write')
        && isValidProduct(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(productId)
        && isValidProduct(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (hasPermission('products.write') && incoming().diff(existing()).affectedKeys().hasOnly([
            'name', 'slug', 'sku', 'categoryId', 'categoryName', 'collectionId', 'collectionName',
            'brand', 'shortDescription', 'description', 'price', 'salePrice', 'costPrice',
            'images', 'videoUrl', 'fabricDetails', 'productType', 'colors', 'sizes', 'variants',
            'stockQuantity', 'trackInventory', 'featured', 'newArrival', 'bestSeller', 'onSale',
            'tags', 'seoTitle', 'seoDescription', 'metaKeywords', 'weightGrams', 'shippingInfo',
            'status', 'isDemo', 'updatedAt'
          ])) ||
          (hasPermission('inventory.adjust') && incoming().diff(existing()).affectedKeys().hasOnly(['stockQuantity', 'variants', 'status', 'updatedAt'])) ||
          (isVerified() && incoming().diff(existing()).affectedKeys().hasOnly(['stockQuantity', 'variants', 'salesCount', 'status', 'updatedAt'])
            && incoming().stockQuantity <= existing().stockQuantity
            && incoming().salesCount >= existing().salesCount)
        );
      allow delete: if isValidId(productId) && hasPermission('products.write');
    }

    match /inventoryMovements/{movementId} {
      allow get: if isValidId(movementId) && hasPermission('inventory.adjust');
      allow list: if isBootstrappedSuperAdmin();
      allow create: if isValidId(movementId)
        && (hasPermission('inventory.adjust') || isVerified())
        && isValidInventoryMovement(incoming())
        && incoming().performedBy == request.auth.uid
        && incoming().createdAt == request.time;
    }

    match /orders/{orderId} {
      allow get: if isValidId(orderId) && (hasPermission('orders.manage') || (resource != null && isOwner(existing().userId)));
      allow list: if isBootstrappedSuperAdmin() || (isVerified() && resource.data.userId == request.auth.uid);
      allow create: if isValidId(orderId)
        && isVerified()
        && isValidOrder(incoming())
        && incoming().userId == request.auth.uid
        && incoming().orderStatus == 'Order Placed'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(orderId)
        && isValidOrder(incoming())
        && incoming().userId == existing().userId
        && incoming().orderNumber == existing().orderNumber
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (hasPermission('orders.manage') && incoming().diff(existing()).affectedKeys().hasOnly(['orderStatus', 'paymentStatus', 'trackingNumber', 'courierName', 'statusHistory', 'orderNotes', 'updatedAt'])) ||
          (isOwner(existing().userId)
            && existing().orderStatus == 'Order Placed'
            && incoming().orderStatus == 'Cancelled'
            && incoming().diff(existing()).affectedKeys().hasOnly(['orderStatus', 'statusHistory', 'updatedAt']))
        );
      allow delete: if isValidId(orderId) && isSuperAdmin();
    }

    match /guestOrders/{orderId} {
      allow get: if isValidId(orderId) && hasPermission('orders.manage');
      allow list: if isBootstrappedSuperAdmin();
      allow create: if isValidId(orderId)
        && isValidOrder(incoming())
        && incoming().userId == 'guest'
        && incoming().orderStatus == 'Order Placed'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(orderId)
        && hasPermission('orders.manage')
        && isValidOrder(incoming())
        && incoming().userId == existing().userId
        && incoming().orderNumber == existing().orderNumber
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['orderStatus', 'paymentStatus', 'trackingNumber', 'courierName', 'statusHistory', 'orderNotes', 'updatedAt']);
      allow delete: if isValidId(orderId) && isSuperAdmin();
    }

    match /orderTracking/{orderNumber} {
      allow get: if isValidId(orderNumber);
      allow list: if isBootstrappedSuperAdmin();
      allow create: if isValidId(orderNumber)
        && isValidOrderTracking(incoming())
        && incoming().orderNumber == orderNumber
        && incoming().orderStatus == 'Order Placed'
        && incoming().updatedAt == request.time;
      allow update: if isValidId(orderNumber)
        && hasPermission('orders.manage')
        && isValidOrderTracking(incoming())
        && incoming().orderNumber == existing().orderNumber
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['orderStatus', 'courierName', 'trackingNumber', 'statusHistory', 'updatedAt']);
      allow delete: if isValidId(orderNumber) && isSuperAdmin();
    }

    match /reviews/{reviewId} {
      allow get: if isValidId(reviewId) && (hasPermission('reviews.moderate') || (resource != null && (existing().status == 'Approved' || isOwner(existing().userId))));
      allow list: if existing().status == 'Approved' || isBootstrappedSuperAdmin() || (isVerified() && resource.data.userId == request.auth.uid);
      allow create: if isValidId(reviewId)
        && isVerified()
        && isValidReview(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (
          hasPermission('reviews.moderate') ||
          (incoming().userId == request.auth.uid
            && incoming().status == 'Pending'
            && (!('featured' in incoming()) || incoming().featured == false))
        );
      allow update: if isValidId(reviewId)
        && hasPermission('reviews.moderate')
        && isValidReview(incoming())
        && incoming().userId == existing().userId
        && incoming().productId == existing().productId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'featured', 'adminReply', 'verifiedPurchase', 'updatedAt']);
      allow delete: if isValidId(reviewId) && (hasPermission('reviews.moderate') || (resource != null && isOwner(existing().userId)));
    }

    match /coupons/{couponId} {
      allow get: if isValidId(couponId) && (hasPermission('marketing.manage') || (resource != null && existing().active == true));
      allow list: if isBootstrappedSuperAdmin();
      allow create: if isValidId(couponId)
        && hasPermission('marketing.manage')
        && isValidCoupon(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(couponId)
        && hasPermission('marketing.manage')
        && isValidCoupon(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['code', 'type', 'value', 'minOrderAmount', 'maxUses', 'usedCount', 'expiresAt', 'active', 'description', 'isDemo', 'updatedAt']);
      allow delete: if isValidId(couponId) && hasPermission('marketing.manage');
    }

    match /banners/{bannerId} {
      allow get: if isValidId(bannerId) && (hasPermission('marketing.manage') || (resource != null && existing().active == true));
      allow list: if existing().active == true || isBootstrappedSuperAdmin();
      allow create: if isValidId(bannerId)
        && hasPermission('marketing.manage')
        && isValidBanner(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(bannerId)
        && hasPermission('marketing.manage')
        && isValidBanner(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'subtitle', 'ctaPrimaryText', 'ctaPrimaryLink', 'ctaSecondaryText', 'ctaSecondaryLink', 'desktopImage', 'mobileImage', 'active', 'sortOrder', 'isDemo', 'updatedAt']);
      allow delete: if isValidId(bannerId) && hasPermission('marketing.manage');
    }

    match /newsletter/{subscriberId} {
      allow get, list: if isBootstrappedSuperAdmin();
      allow create: if isValidId(subscriberId)
        && isValidNewsletter(incoming())
        && incoming().createdAt == request.time;
      allow delete: if isValidId(subscriberId) && hasPermission('marketing.manage');
    }

    match /analyticsEvents/{eventId} {
      allow get: if isValidId(eventId) && hasPermission('analytics.view');
      allow list: if isBootstrappedSuperAdmin();
      allow create: if isValidId(eventId)
        && isValidAnalyticsEvent(incoming())
        && incoming().createdAt == request.time;
    }

    match /notifications/{notificationId} {
      allow get: if isValidId(notificationId) && (isStaff() || (resource != null && isOwner(existing().recipientId)));
      allow list: if isBootstrappedSuperAdmin() || (isVerified() && resource.data.recipientId == request.auth.uid);
      allow create: if isValidId(notificationId)
        && isVerified()
        && isValidNotification(incoming())
        && incoming().createdAt == request.time;
      allow update: if isValidId(notificationId)
        && isValidNotification(incoming())
        && (isOwner(existing().recipientId) || isStaff())
        && incoming().recipientId == existing().recipientId
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['read']);
      allow delete: if isValidId(notificationId) && (isOwner(existing().recipientId) || isSuperAdmin());
    }

    match /auditLogs/{logId} {
      allow get: if isValidId(logId) && hasPermission('audit.view');
      allow list: if isBootstrappedSuperAdmin();
      allow create: if isValidId(logId)
        && isStaff()
        && isValidAuditLog(incoming())
        && incoming().actorUid == request.auth.uid
        && incoming().createdAt == request.time;
    }

    match /settings/{settingId} {
      allow get: if isValidId(settingId) && (settingId == 'public' || hasPermission('settings.manage'));
      allow list: if isBootstrappedSuperAdmin();
      allow create, update: if isValidId(settingId)
        && hasPermission('settings.manage')
        && isValidSettings(incoming())
        && incoming().updatedAt == request.time;
    }
  }
}
